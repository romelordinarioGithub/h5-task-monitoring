    // Scoping
    {
      id: 'scoping_page',
      parentId: 'brief',
      title: 'Sparkworks',
      showIf: { q: 'request_type', op: 'eq', value: 'scoping' },
      fields: [
        {
          id: 'creative_project_goals',
          type: 'long_text',
          label: 'Please tell us about your creative project and goals',
          placeholder:
            'Describe the campaign you need creatives for and what you hope to achieve',
          isRequired: false,
        },
        {
          id: 'stage_funnel_targeting',
          type: 'multi_select',
          label: 'What stage of the funnel is your creative project targeting?',
          isRequired: true,
          options: [
            { id: 'UF', value: 'Upper Funnel (Awareness / Reach)' },
            { id: 'MF', value: 'Middle Funnel (Consideration / Engagement)' },
            {
              id: 'LF',
              value: 'Lower Funnel (Retargeting / Personalization)',
            },
            { id: 'FF', value: 'Full Funnel Targeting' },
          ],
        },
        {
          id: 'existing_creative_templates',
          type: 'single_select',
          label: 'Will this project build on existing creative templates?',
          isRequired: true,
          options: [
            {
              id: 'scratch_raw_assets',
              value:
                'We’re starting from scratch and I only have raw assets to share (images, video, brand guidelines, etc.)',
              price: '12000',
            },
            {
              id: 'scratch_working_files',
              value:
                'We’re starting from scratch but I have layered working files (PSD or Figma)',
            },
            {
              id: 'reusing_existing_templates',
              value: 'Yes, we’re reusing / updating existing templates',
            },
          ],
        },
      ],
    },

    // Reusing existing templates
    {
      id: 'resizing_or_new_iteration_page',
      parentId: 'brief',
      showIf: {
        q: 'existing_creative_templates',
        op: 'eq',
        value: 'reusing_existing_templates',
      },
      fields: [
        {
          id: 'resizing_or_new_iteration',
          type: 'single_select',
          label: 'Are you resizing or updating existing templates?',
          isRequired: true,
          options: [
            { id: 'resizing', value: 'Resizing' },
            { id: 'new_iteration', value: 'New Iteration' },
          ],
        },
      ],
    },

    // Scoping - New iteration
    {
      id: 'new_iteration_page',
      parentId: 'brief',
      showIf: {
        all: [
          { q: 'request_type', op: 'eq', value: 'scoping' },
          {
            q: 'existing_creative_templates',
            op: 'eq',
            value: "reusing_existing_templates",
          },
          {
            q: 'resizing_or_new_iteration',
            op: 'eq',
            value: "new_iteration",
          },
        ],
      },
      fields: [
        {
          id: 'iteration_campaign_variants_need',
          type: 'text',
          label: 'How many more iterations / campaign variants do you need?',
          isRequired: true,
        },
      ],
    },

    // Scoping - Existing - Platforms advertising on
    {
      id: 'existing_platforms_advertising_on_page',
