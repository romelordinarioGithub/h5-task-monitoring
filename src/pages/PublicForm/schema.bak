            { id: '16:9', value: '16:9', price: '1400' },
          ],
        },
      ],
    },

    // Scoping - Scratch - Iterations Y/N
    {
      id: 'scratch_iterations_languages_page',
      parentId: 'brief',
      showIf: {
        all: [
          { q: 'request_type', op: 'eq', value: 'scoping' },
          {
            q: 'existing_creative_templates',
            op: 'in',
            value: ["scratch_raw_assets", "scratch_working_files"],
          },
        ],
      },
      fields: [
        {
          id: 'need_iterations_campaign_variants',
          type: 'single_select',
          label: 'Will you need more iterations / run campaign variants?',
          isCompact: true,
          options: [
            { id: 'yes', value: 'Yes', price: '1400' },
            { id: 'no', value: 'No' },
          ],
        },
